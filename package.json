{
  "name": "@shinshin86/sayx",
  "version": "0.1.1",
  "description": "Text-to-speech CLI tool powered by @aituber-onair/voice",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "sayx": "./dist/cli.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test \"test/**/*.test.mjs\"",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "tts",
    "text-to-speech",
    "voice",
    "cli",
    "voicevox",
    "openai"
  ],
  "author": "shinshin86 <shinshin86npm@gmail.com> (https://github.com/shinshin86)",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@aituber-onair/voice": "^0.8.0",
    "commander": "^12.1.0",
    "env-paths": "^3.0.0",
    "file-type": "^19.6.0",
    "play-sound": "^1.1.6",
    "yaml": "^2.6.1"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "@types/play-sound": "^1.1.2",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3"
  }
}
